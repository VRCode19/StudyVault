# StudyVault AI Web Service Environment Variables (Render)
# PORT is dynamically assigned by Render in production (leave unset or 5001 for local dev)
PORT=5001
NODE_ENV=production

# OpenRouter API Key (Server-side ONLY — Never exposed to browser or frontend)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FALLBACK_MODEL=liquid/lfm-2.5-2.6b:free

# Backend mode: mock (self-contained local state) or http (connects to external API)
BACKEND_MODE=mock
BACKEND_BASE_URL=http://localhost:5000/api/v1

# CORS: Comma-separated list of allowed origins (e.g. your Vercel deployment URL)
CORS_ORIGIN=https://your-studyvault-app.vercel.app,http://localhost:5173
