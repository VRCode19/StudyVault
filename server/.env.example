PORT=5001
NODE_ENV=development

# OpenRouter Authentication (Server-Side ONLY)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=anthropic/claude-3.5-sonnet

# Core Backend Communication
# Set to 'mock' for local dev using mock adapter, or 'http' when connecting to teammate's backend
BACKEND_MODE=mock
BACKEND_BASE_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:5173
